<component type="desktop-application">
  <id>io.github.steeb_k.Post</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Post</name>
  <summary>Mails and more</summary>
  <description>
    <p>No description</p>
  </description>
  <developer id="io.github.steeb_k">
    <name>steeb-k</name>
  </developer>
  <url type="homepage">https://github.com/steeb-k/post</url>
  <url type="vcs-browser">https://github.com/steeb-k/post</url>
  <url type="bugtracker">https://github.com/steeb-k/post/issues</url>
  <translation type="gettext">post-mail</translation>
  <launchable type="desktop-id">io.github.steeb_k.Post.desktop</launchable>
  <content_rating type="oars-1.1" />
  <branding>
    <color type="primary" scheme_preference="light">#b5b2ff</color>
    <color type="primary" scheme_preference="dark">#05009d</color>
  </branding>
  <releases>
    <release version="0.4.1" date="2026-09-29">
      <description>
        <p>Fixes:</p>
        <ul>
          <li>A click into a message body no longer jumps the conversation instead of following the link</li>
          <li>A link opens the browser in front of the window, not behind it</li>
          <li>A new mail is spell-checked in your language, not German</li>
        </ul>
        <p>Also:</p>
        <ul>
          <li>The app icon is drawn as vectors, and reads at every size</li>
          <li>The sidebar is narrower, sized to the calendar's date chooser</li>
        </ul>
      </description>
    </release>
    <release version="0.4.0" date="2026-09-14">
      <description>
        <p>Features:</p>
        <ul>
          <li>An unread mail is marked with a bar down the side of its row</li>
          <li>The Mail button shows an unread badge, and both badges can be switched off</li>
          <li>A clustered view gathers mails that share a subject</li>
          <li>A starred conversation stays bold until it is opened</li>
          <li>Star a mail from its row, and keep starred mails in a section on top</li>
          <li>Folders can be coloured, and a mail's other folders show on its row</li>
          <li>Refresh the mail list with a trackpad swipe</li>
          <li>Signatures get the composer's formatting bar</li>
        </ul>
        <p>Fixes:</p>
        <ul>
          <li>The Mail badge counts the inbox the sidebar is showing</li>
          <li>An AMP for Email body no longer shows up as a blank attachment</li>
          <li>A new mail starts from the account the active profile has open, with the caret in To</li>
          <li>A rejected account no longer floods its server with reconnects, and reconnects after the network comes back</li>
          <li>Moving a Gmail message to the trash works</li>
          <li>Ctrl+C copies out of a message body</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
