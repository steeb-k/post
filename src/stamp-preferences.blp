using Gtk 4.0;
using Adw 1;

template $StampPreferences: Adw.PreferencesDialog {
  content-width: 640;
  content-height: 580;
  search-enabled: true;

  /*
   * Narrow enough and the dialog is presented as a bottom sheet, where the
   * 580px meant for a desktop dialog only covers the lower half of a phone
   * screen. Ask for more height than any phone has so the sheet grows to
   * the window, leaving just the app's header bar showing behind it.
   */
  Adw.Breakpoint {
    condition ("max-width: 500sp")

    setters {
      template.content-height: 2000;
    }
  }

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "applications-system-symbolic";

    Adw.PreferencesGroup general_group {
      title: _("General");

      Adw.SwitchRow background_notifications {
        title: _("Background Notifications");
        subtitle: _("Fetch notifications while the app is closed");
      }

      Adw.SwitchRow autostart {
        title: _("Autostart");
        subtitle: _("Start during system startup in background");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Mail");
    icon-name: "mail-unread-symbolic";

    Adw.PreferencesGroup reader_group {
      title: _("General");

      Adw.SpinRow mark_read {
        title: _("Mark Read Timeout");

        [suffix]
        Label {
          label: _("sec");
        }

        adjustment: Adjustment {
          step-increment: 0.5;
          page-increment: 1.0;
          lower: 0.0;
          upper: 10.0;
          value: 3.0;
        };

        digits: 1;
        climb-rate: 0.1;
      }

      Adw.SpinRow refresh_interval {
        title: _("Folder Refresh Interval");
        subtitle: _("Interval after which folders should be checked for changes");

        [suffix]
        Label {
          label: _("sec");
        }

        adjustment: Adjustment {
          step-increment: 1.0;
          page-increment: 5.0;
          lower: 10.0;
          upper: 360.0;
          value: 60.0;
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Visual");

      Adw.PreferencesRow {
        title: _("Layout");
        activatable: false;
        focusable: false;

        child: Box {
          orientation: vertical;
          spacing: 6;
          margin-top: 12;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;

          Label {
            label: _("Layout");
            xalign: 0;

            styles [
              "heading",
            ]
          }

          Label {
            label: _("Where the reading pane and the agenda sit. A profile can ask for a different one while it is active.");
            xalign: 0;
            wrap: true;
            margin-bottom: 6;

            styles [
              "caption",
              "dim-label",
            ]
          }

          $StampLayoutPicker {
            action-name: "app.default-mail-layout";
          }
        };
      }

      Adw.SwitchRow always_show_images {
        title: _("Always Show Images");
        subtitle: _("Except for Junk and Trash folders");
      }

      Adw.SwitchRow bimi_images {
        title: _("Load Verified Company Logos from BIMI");
        subtitle: _("Should offer more trust and provide protection against phishing attempts");
      }

      Adw.SwitchRow important_first {
        title: _("Show important mails on top");
      }
    }

    Adw.PreferencesGroup signatures_group {
      title: _("Signatures");
      description: _("Blocks of text added to the end of a message. An account can pick one to use by default, and the composer can switch or drop it per message.");

      Adw.ButtonRow add_signature {
        title: _("Add Signature");
        start-icon-name: "list-add-symbolic";
        activated => $on_add_signature_clicked();
      }
    }

    Adw.PreferencesGroup {
      title: _("Audio");

      Adw.SwitchRow play_incoming_sound {
        title: _("Play Incoming Sound");
        subtitle: _("Audio notification for new incoming mails");
      }
    }
  }

  $StampPreferencesCalendars {}

  Adw.PreferencesPage {
    title: _("Accounts");
    icon-name: "avatar-default-symbolic";

    Adw.PreferencesGroup accounts_group {
      title: _("Accounts");
      description: _("Accounts are added and removed in GNOME Online Accounts");

      Adw.ButtonRow add_account {
        title: _("Open GNOME Online Accounts");
        start-icon-name: "system-users-symbolic";
        activated => $on_add_account_clicked();
      }
    }
  }
}

