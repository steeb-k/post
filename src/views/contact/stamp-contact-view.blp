using Gtk 4.0;
using Adw 1;

template $StampContactView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 200;

  Adw.Breakpoint bp_tablet {
    condition ("max-width: 1200sp")
    apply => $on_apply_view();
    unapply => $on_apply_view();

    setters {
      contacts_layout.layout-name: "tablet";
    }
  }

  Adw.Breakpoint bp_mobile {
    condition ("max-width: 550sp")
    apply => $on_apply_view();
    unapply => $on_apply_view();

    setters {
      contacts_layout.layout-name: "mobile";
      app_switcher.policy: narrow;
      contact_content.orientation: vertical;
      contact_content.spacing: 0;
      switcher_sizes.mode: horizontal;
    }
  }

  child: Adw.MultiLayoutView contacts_layout {
    [sidebar]
    Adw.ToolbarView sidebar_pane {
      bottom-bar-style: raised;

      [top]
      $StampHeaderBar {}

      content: ScrolledWindow scrolled_window {
        hscrollbar-policy: never;

        child: $StampBookList book_list {
          vexpand: true;
          book-selected => $on_book_selected();
        };
      };
    }

    [list]
    $StampContactList contact_list {
      contact-selected => $on_contact_selected();
    }

    [content]
    $StampContactDetails contact_details {}

    /* The switcher floats over the columns rather than sitting in a bar
     * under them: a full-width bar shortens the sidebar too, and the
     * sidebar has nothing to spare. Centred on the window, not on the
     * content, so it reads as window chrome. */
    Adw.Layout {
      name: "desktop";

      content: Overlay {
        child: Adw.OverlaySplitView outer_osv {
          sidebar-width-fraction: 0.28;
          min-sidebar-width: 250;
          max-sidebar-width: 300;
          show-sidebar: true;

          sidebar: Adw.LayoutSlot {
            id: "sidebar";
          };

          content: Paned desktop_paned {
            styles [
              "wide-grab-divider",
            ]

            orientation: horizontal;
            position: 400;
            shrink-start-child: false;
            shrink-end-child: false;
            resize-start-child: false;
            resize-end-child: true;

            /* Side by side puts both columns against the bottom edge,
             * so both have to leave room for the pill. The tablet and
             * mobile layouts park the switcher in a real bottom bar,
             * which takes its own space and needs no clearance. */
            start-child: Adw.LayoutSlot {
              id: "list";

              styles [
                "switcher-clearance",
              ]
            };

            end-child: Adw.LayoutSlot {
              id: "content";

              styles [
                "switcher-clearance",
              ]
            };
          };
        };

        [overlay]
        Adw.LayoutSlot {
          id: "switcher";
          halign: center;
          valign: end;

          styles [
            "floating-switcher",
          ]
        }
      };
    }

    Adw.Layout {
      name: "tablet";

      content: Adw.OverlaySplitView tablet_osv {
        sidebar-width-fraction: 0.28;
        min-sidebar-width: 280;
        max-sidebar-width: 340;
        collapsed: true;

        sidebar: Adw.LayoutSlot {
          id: "sidebar";
        };

        content: Adw.ToolbarView {
          bottom-bar-style: raised;

          content: Paned tablet_paned {
            styles [
              "wide-grab-divider",
            ]

            orientation: horizontal;
            position: 400;
            shrink-start-child: false;
            shrink-end-child: false;
            resize-start-child: false;
            resize-end-child: true;

            start-child: Adw.LayoutSlot {
              id: "list";
            };

            end-child: Adw.LayoutSlot {
              id: "content";
            };
          };

          [bottom]
          Adw.LayoutSlot {
            id: "switcher";
          }
        };
      };
    }

    Adw.Layout {
      name: "mobile";

      content: Adw.NavigationView mobile_nav {
        Adw.NavigationPage {
          title: _("Contacts");
          tag: "main";

          child: Adw.OverlaySplitView mobile_osv {
            collapsed: true;
            sidebar-position: start;
            sidebar-width-fraction: 0.75;
            min-sidebar-width: 280;
            max-sidebar-width: 300;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Adw.ToolbarView {
              content: Adw.LayoutSlot {
                id: "list";
              };

              [bottom]
              Adw.LayoutSlot {
                id: "switcher";
              }
            };
          };
        }

        Adw.NavigationPage {
          title: _("Inhalt");
          tag: "content";

          child: Adw.LayoutSlot {
            id: "content";
          };
        }
      };
    }

    /* Same shape as the mail and calendar views': the destinations, a
     * rule, then the one thing this view makes. */
    [switcher]
    Box switcher_box {
      halign: center;
      spacing: 6;
      margin-top: 6;
      margin-bottom: 6;

      Adw.ViewSwitcher app_switcher {
        stack: bind template.stack;
        policy: wide;
      }

      /* Only the pill needs dividing up; a bar spanning the window has
       * its own edges. */
      Separator contact_separator {
        orientation: vertical;
        margin-top: 3;
        margin-bottom: 3;
      }

      Button contact_button {
        accessibility {
          label: C_("tooltip", "Add Contact");
        }

        valign: center;
        tooltip-text: C_("tooltip", "Add Contact");
        action-name: "contacts.new-contact";

        styles [
          "suggested-action",
          "switcher-action",
        ]

        child: Box contact_content {
          halign: center;
          spacing: 6;

          /* The calendar's action adds a plus to a generic row; a
           * contact has a shape of its own, so the plus rides on the
           * silhouette rather than standing alone. */
          Image {
            icon-name: "contact-new-symbolic";
          }

          Label {
            label: _("Contact");
          }
        };
      }
    }
  };
}

/* See StampMailView: the action takes its width from one of the
 * switcher's own buttons, so the stacked row is four of a kind. */
SizeGroup switcher_sizes {
  mode: none;

  widgets [
    contact_button,
  ]
}
