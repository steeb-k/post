using Gtk 4.0;
using Adw 1;

template $StampContactView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 200;

  Adw.Breakpoint bp_tablet {
    condition ("max-width: 1200sp")
    apply => $on_apply_view();
    unapply => $on_apply_view();

    setters {
      contacts_layout.layout-name: "tablet";
    }
  }

  Adw.Breakpoint bp_mobile {
    condition ("max-width: 550sp")
    apply => $on_apply_view();
    unapply => $on_apply_view();

    setters {
      contacts_layout.layout-name: "mobile";
      app_switcher.policy: narrow;
    }
  }

  child: Adw.MultiLayoutView contacts_layout {
    [sidebar]
    Adw.ToolbarView sidebar_pane {
      bottom-bar-style: raised;

      [top]
      $StampHeaderBar {}

      content: ScrolledWindow scrolled_window {
        hscrollbar-policy: never;

        child: $StampBookList book_list {
          vexpand: true;
          book-selected => $on_book_selected();
        };
      };
    }

    [list]
    $StampContactList contact_list {
      contact-selected => $on_contact_selected();
    }

    [content]
    $StampContactDetails contact_details {}

    /* The switcher floats over the columns rather than sitting in a bar
     * under them: a full-width bar shortens the sidebar too, and the
     * sidebar has nothing to spare. Centred on the window, not on the
     * content, so it reads as window chrome. */
    Adw.Layout {
      name: "desktop";

      content: Overlay {
        child: Adw.OverlaySplitView outer_osv {
          sidebar-width-fraction: 0.28;
          min-sidebar-width: 250;
          max-sidebar-width: 300;
          show-sidebar: true;

          sidebar: Adw.LayoutSlot {
            id: "sidebar";
          };

          content: Paned desktop_paned {
            styles [
              "wide-grab-divider",
            ]

            orientation: horizontal;
            position: 400;
            shrink-start-child: false;
            shrink-end-child: false;
            resize-start-child: false;
            resize-end-child: true;

            start-child: Adw.LayoutSlot {
              id: "list";
            };

            end-child: Adw.LayoutSlot {
              id: "content";
            };
          };
        };

        [overlay]
        Adw.LayoutSlot {
          id: "switcher";
          halign: center;
          valign: end;

          styles [
            "floating-switcher",
          ]
        }
      };
    }

    Adw.Layout {
      name: "tablet";

      content: Adw.OverlaySplitView tablet_osv {
        sidebar-width-fraction: 0.28;
        min-sidebar-width: 280;
        max-sidebar-width: 340;
        collapsed: true;

        sidebar: Adw.LayoutSlot {
          id: "sidebar";
        };

        content: Adw.ToolbarView {
          bottom-bar-style: raised;

          content: Paned tablet_paned {
            styles [
              "wide-grab-divider",
            ]

            orientation: horizontal;
            position: 400;
            shrink-start-child: false;
            shrink-end-child: false;
            resize-start-child: false;
            resize-end-child: true;

            start-child: Adw.LayoutSlot {
              id: "list";
            };

            end-child: Adw.LayoutSlot {
              id: "content";
            };
          };

          [bottom]
          Adw.LayoutSlot {
            id: "switcher";
          }
        };
      };
    }

    Adw.Layout {
      name: "mobile";

      content: Adw.NavigationView mobile_nav {
        Adw.NavigationPage {
          title: _("Contacts");
          tag: "main";

          child: Adw.OverlaySplitView mobile_osv {
            collapsed: true;
            sidebar-position: start;
            sidebar-width-fraction: 0.75;
            min-sidebar-width: 280;
            max-sidebar-width: 300;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Adw.ToolbarView {
              content: Adw.LayoutSlot {
                id: "list";
              };

              [bottom]
              Adw.LayoutSlot {
                id: "switcher";
              }
            };
          };
        }

        Adw.NavigationPage {
          title: _("Inhalt");
          tag: "content";

          child: Adw.LayoutSlot {
            id: "content";
          };
        }
      };
    }

    [switcher]
    Adw.ViewSwitcher app_switcher {
      stack: bind template.stack;
      policy: wide;
      halign: center;
      margin-top: 6;
      margin-bottom: 6;
    }
  };
}
