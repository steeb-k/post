using Gtk 4.0;
using Adw 1;

template $StampContactDetails: Box {
  orientation: vertical;

  Stack stack {
    vexpand: true;

    StackPage {
      name: "empty";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-title: false;
        }

        Adw.StatusPage {
          title: _("No Contact Selected");
          icon-name: "avatar-default-symbolic";
        }
      };
    }

    StackPage {
      name: "content";

      child: Adw.ToolbarView {
        [top]
        Adw.HeaderBar {
          show-title: false;

          /* Insensitive rather than hidden when the book will not take
           * writes, so a read-only address book reads as a property of
           * the book and not as a contact that cannot be edited. */
          [end]
          Button edit_button {
            icon-name: "document-edit-symbolic";
            tooltip-text: _("Edit Contact");
            clicked => $on_edit_clicked();
          }
        }

        ScrolledWindow {
          hscrollbar-policy: never;
          can-focus: false;

          child: Adw.Bin {
            child: Adw.Clamp {
              margin-top: 12;
              margin-start: 12;
              margin-end: 12;

              child: Box {
                orientation: vertical;
                spacing: 24;

                styles [
                  "contact-details-body",
                ]

                Adw.Avatar avatar {
                  show-initials: true;
                  size: 128;

                  styles [
                    "icon-dropshadow",
                  ]
                }

                Label name {
                  wrap: true;
                  wrap-mode: word_char;
                  justify: center;

                  styles [
                    "title-1",
                  ]

                  margin-bottom: 6;
                  xalign: 0.5;
                }

                ListBox mail {
                  selection-mode: none;

                  styles [
                    "content",
                  ]

                  visible: false;
                }

                ListBox phone {
                  selection-mode: none;

                  styles [
                    "content",
                  ]

                  visible: false;
                }

                ListBox address {
                  selection-mode: none;

                  styles [
                    "content",
                  ]

                  visible: false;
                }

                ListBox birthday {
                  selection-mode: none;

                  styles [
                    "content",
                  ]

                  visible: false;
                }

                ListBox notes {
                  selection-mode: none;

                  styles [
                    "content",
                  ]

                  visible: false;
                }

                /* Last, and no wider than its own label: removing a
                 * contact is the one thing on this pane that cannot be
                 * undone, so it does not sit among the fields nor
                 * stretch across them like something routine. */
                Button delete_button {
                  label: _("Delete Contact");
                  halign: center;
                  margin-top: 12;
                  margin-bottom: 24;
                  clicked => $on_delete_clicked();

                  styles [
                    "destructive-action",
                    "pill",
                  ]
                }
              };
            };
          };
        }
      };
    }
  }
}
