using Gtk 4.0;
using Adw 1;

template $StampPhotoCrop: Adw.Dialog {
  content-width: 400;
  title: _("Crop Photo");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      title-widget: Adw.WindowTitle {
        title: _("Crop Photo");
      };

      [start]
      Button {
        label: _("_Cancel");
        use-underline: true;
        clicked => $on_cancel_clicked();
      }

      [end]
      Button select_button {
        label: _("_Select");
        use-underline: true;
        clicked => $on_select_clicked();

        styles [
          "suggested-action",
        ]
      }
    }

    content: Box {
      orientation: vertical;
      spacing: 18;
      margin-top: 18;
      margin-bottom: 18;
      margin-start: 18;
      margin-end: 18;

      /* The crop area is built in C: it is a private widget type, and
       * keeping it out of the template saves registering one just so
       * the parser can find it. */
      Box crop_container {
        halign: center;
      }

      /* Dragging pans and scrolling zooms, but neither is discoverable
       * and neither is reachable without a pointer, so the zoom is also
       * a control you can see and tab to. */
      Box {
        spacing: 12;

        Image {
          icon-name: "zoom-out-symbolic";
        }

        Scale zoom_scale {
          hexpand: true;
          draw-value: false;

          adjustment: Adjustment {
            lower: 1.0;
            upper: 8.0;
            value: 1.0;
            step-increment: 0.1;
            page-increment: 0.5;
          };

          accessibility {
            label: _("Zoom");
          }
        }

        Image {
          icon-name: "zoom-in-symbolic";
        }
      }
    };
  };
}
