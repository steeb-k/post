using Gtk 4.0;
using Adw 1;

template $StampCalendarView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 200;

  child: Adw.NavigationSplitView outer_view {
    min-sidebar-width: 200;
    max-sidebar-width: 351;
    sidebar-width-fraction: 0.47;

    sidebar: Adw.NavigationPage inner_view_page {
      title: _("Stamp");

      child: Adw.ToolbarView {
        bottom-bar-style: raised;

        [top]
        Adw.HeaderBar {
          [start]
          Adw.Spinner spinner {
            visible: false;
          }

          [end]
          MenuButton {
            primary: true;
            icon-name: "open-menu-symbolic";
            menu-model: primary_menu;
          }
        }

        content: Box {
          orientation: vertical;

          ScrolledWindow {
            hscrollbar-policy: never;
            child: Label calendar_list {
              vexpand: true;
            };
          }
        };

        [bottom]
        Adw.ViewSwitcherBar view_switcher {
          reveal: true;
        }
      };
    };

    content: Adw.NavigationPage week_page {
      tag: "week";
      title: _("Week");

      child: $StampWeekView week_view {};
    };
  };

  Adw.Breakpoint breakpoint_small {
    condition ("max-width: 500sp")

    setters {
      outer_view.collapsed: true;
    }
  }
}

menu primary_menu {
  section {
    item {
      label: _("A_ccounts");
      action: 'app.accounts';
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: 'app.preferences';
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Stamp");
      action: 'app.about';
    }
  }

  section {
    item {
      label: _("_Quit");
      action: 'app.quit';
    }
  }
}
