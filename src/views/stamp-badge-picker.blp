using Gtk 4.0;
using Adw 1;

template $StampBadgePicker: Adw.Dialog {
  title: _("Badge");
  content-width: 420;
  content-height: 520;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;

      child: FlowBox grid {
        selection-mode: none;
        homogeneous: true;
        row-spacing: 6;
        column-spacing: 6;
        min-children-per-line: 3;
        max-children-per-line: 4;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;
        valign: start;
      };
    };
  };
}
