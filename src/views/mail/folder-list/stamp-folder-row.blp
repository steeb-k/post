using Gtk 4.0;
using Adw 1;

template $StampFolderRow: Box {
  orientation: horizontal;

  styles [
    "folder-row",
  ]

  Image image {
    accessibility {
      label: _("Folder Type Icon");
    }
  }

  Inscription inscription {
    hexpand: true;
    xalign: 0;
    text-overflow: ellipsize_end;
  }

  Adw.Spinner spinner {
    visible: false;
  }

  Label unread {
    styles [
      "counter",
      "long",
      "numeric",
      "needs-attention",
    ]

    visible: false;
  }

  Image error {
    accessibility {
      label: _("Error");
    }

    icon-name: "dialog-error-symbolic";
    visible: false;
  }
}
