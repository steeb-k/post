using Gtk 4.0;
using Adw 1;

template $StampConversationRow: Box {
  orientation: vertical;

  Overlay {
    vexpand: true;

    [overlay]
    Box left_action {
      orientation: vertical;
      halign: start;
      opacity: 0;
      valign: center;
      spacing: 6;
      margin-start: 6;
      margin-end: 6;

      styles [
        "accent",
      ]

      Image left_action_image {
        accessibility {
          label: _("Mark Read");
        }

        icon-name: 'mark-read-symbolic';
      }

      Label left_action_label {
        label: _("Mark Read");

        styles [
          "heading",
        ]
      }
    }

    [overlay]
    Box right_action {
      orientation: vertical;
      halign: end;
      opacity: 0;
      valign: center;
      spacing: 6;
      margin-start: 6;
      margin-end: 6;

      styles [
        "error",
      ]

      Image {
        accessibility {
          label: _("Move to Trash");
        }

        icon-name: 'user-trash-symbolic';
      }

      Label {
        label: _("Trash");

        styles [
          "heading",
        ]
      }
    }

    child: Grid row {
      hexpand: true;
      vexpand: true;
      halign: start;

      styles [
        "conversation-row",
      ]

      Stack stack {
        Adw.Avatar avatar {
          valign: start;
          size: 32;
          show-initials: true;
        }

        CheckButton check_button {
          valign: start;
          toggled => $on_check_button_toggled();
          can-focus: false;

          styles [
            "selection-mode",
          ]
        }

        layout {
          row: 0;
          column: 0;
          row-span: 3;
        }
      }

      Box {
        layout {
          column: 1;
          row: 0;
        }

        Inscription participants {
          hexpand: true;
          xalign: 0;
          text-overflow: ellipsize_end;
          nat-chars: 999;
        }

        /* What a mail is stands beside when it came in, on the line the
         * date is on: these belong to this mail, and a line of their
         * own would have parked them under the date of the mail above. */
        Image reply_icon {
          accessibility {
            label: _("Replied to Mail");
          }

          icon-name: "mail-replied-symbolic";
          visible: false;
        }

        Image forwarded_icon {
          accessibility {
            label: _("Forwarded Mail");
          }

          icon-name: "mail-forward-symbolic";
          visible: false;
        }

        Image calendar_icon {
          accessibility {
            label: _("Mail With an Invitation");
          }

          icon-name: "x-office-calendar-symbolic";
          visible: false;
        }

        Image attachment_icon {
          accessibility {
            label: _("Mail Attachment");
          }

          icon-name: "mail-attachment-symbolic";
          visible: false;
        }

        Label date {
          xalign: 1;
          ellipsize: end;

          styles [
            "caption",
          ]
        }

        /* The star sits last on the line, past the date, so every row
         * ends on the same thing and the dates line up with each other
         * instead of being pushed about by a star that comes and goes.
         *
         * It keeps clear of the right edge because the overlay scrollbar
         * lives there: sitting under it, the star was half hidden, and
         * the scrollbar took the pointer before the star could light up
         * from anywhere but the left. */
        Button flagged_button {
          valign: center;
          margin-end: 12;
          clicked => $on_flagged_clicked();
          can-focus: false;
          tooltip-text: _("Star Mail");

          styles [
            "flat",
            "star-button",
          ]

          Image flagged_icon {
            accessibility {
              label: _("Flagged Mail");
            }

            icon-name: "non-starred-symbolic";
          }
        }
      }

      Box {
        layout {
          column: 1;
          row: 1;
        }

        Inscription topic {
          hexpand: true;
          xalign: 0;
          text-overflow: ellipsize_end;
        }

        Label counter {
          styles [
            "counter",
            "numeric",
            "long",
          ]

          valign: center;
        }
      }

      Box {
        layout {
          column: 1;
          row: 2;
        }

        FlowBox labels {
          selection-mode: none;
        }

        Inscription body {
          hexpand: true;
          xalign: 0;
          valign: center;
          text-overflow: ellipsize_end;

          styles [
            "caption",
          ]
        }

        /* Which other folders the mail sits in -- its Gmail labels. Last
         * on the line and after the hexpanding preview, so it is the
         * preview that gives way as the window narrows, not the chip. */
        Box folders {
          /* Expands as well as aligns to the end: a mail with no preview
           * hides the inscription beside this, and without something
           * claiming the slack the chip would slide back to the left. */
          hexpand: true;
          halign: end;
          valign: center;
          spacing: 3;
          visible: false;
        }
      }
    };

    GestureDrag {
      drag-update => $on_drag_update();
      drag-end => $on_drag_end();
      propagation-phase: capture;
    }
  }
}
