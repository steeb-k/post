using Gtk 4.0;
using Adw 1;

template $StampMailView: Adw.BreakpointBin {
  width-request: 360;
  height-request: 200;
  notify::current-breakpoint => $on_size_changed(template) not-swapped;

  /* Which breakpoint is current decides how much room there is; the
   * chosen layout decides what to do with it. $on_size_changed() puts
   * the two together and names the layout. */
  Adw.Breakpoint bp_tablet {
    condition ("max-width: 1200sp")
  }

  Adw.Breakpoint bp_mobile {
    condition ("max-width: 550sp")

    setters {
      app_switcher.policy: narrow;
    }
  }

  child: Adw.ToastOverlay toast_overlay {
    child: Adw.MultiLayoutView mail_layout {
      [sidebar]
      Adw.ToolbarView sidebar_pane {
        /* No line and no shadow above the agenda: the strip paints its
         * own darker background with rounded top corners, which is the
         * break. A raised bar would also paint the corners back in.
         * A flat bar asks the folder list for an undershoot line
         * instead, which the stylesheet turns off. */
        bottom-bar-style: flat;

        /* The folder list runs all the way to the bottom edge, so its
         * rows show through the gap beside the tab and stay scrollable
         * there. Trailing space under the list, sized to the card's
         * body, keeps the last folder from being stranded behind it. */
        extend-content-to-bottom-edge: true;

        styles [
          "sidebar-agenda-host",
        ]

        [top]
        $StampHeaderBar {}

        content: ScrolledWindow {
          hscrollbar-policy: never;

          child: Box {
            orientation: vertical;

            $StampFolderList folder_list {
              vexpand: true;
              folder-selected => $on_folder_selected();
              folder-cleared => $on_folder_cleared();
            }

            /* Kept the same height as the agenda's body by a size group,
             * so the last folder can always be scrolled clear of it. */
            Box folder_spacer {}
          };
        };

        [bottom]
        $StampSidebarAgenda sidebar_agenda {}
      }

      [list]
      $StampConversationList conversation_list {
        conversation-selected => $on_conversation_selected();
        conversation-trash => $on_conversation_trash();
      }

      [content]
      $StampMessageList message_list {}

      /* Only the dense layout has a slot for this; everywhere else the
       * agenda is the strip at the bottom of the sidebar. The header bar
       * is here because this column is the window's top right corner in
       * that layout, and that is where the window controls belong. */
      [agenda]
      Adw.ToolbarView agenda_pane {
        width-request: 300;

        [top]
        Adw.HeaderBar agenda_header {
          show-start-title-buttons: false;

          title-widget: Adw.WindowTitle {
            title: _("Agenda");
          };
        }

        content: $GcalAgendaView dense_agenda {
          event-activated => $on_agenda_event_activated();
        };
      }

      Adw.Layout {
        name: "desktop";

        content: Adw.ToolbarView {
          bottom-bar-style: raised;

          content: Adw.OverlaySplitView outer_osv {
            sidebar-width-fraction: 0.28;
            min-sidebar-width: 250;
            max-sidebar-width: 300;
            show-sidebar: true;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Paned desktop_paned {
              styles [
                "wide-grab-divider",
              ]

              orientation: horizontal;
              position: 400;
              shrink-start-child: false;
              shrink-end-child: false;
              resize-start-child: false;
              resize-end-child: true;

              start-child: Adw.LayoutSlot {
                id: "list";
              };

              end-child: Adw.LayoutSlot {
                id: "content";
              };
            };
          };

          [bottom]
          Adw.LayoutSlot {
            id: "switcher";
          }
        };
      }

      /* Stacked: the sidebar keeps the full height it has side by side,
       * and the list hands its width to the reading pane below it. */
      Adw.Layout {
        name: "desktop-stacked";

        content: Adw.ToolbarView {
          bottom-bar-style: raised;

          content: Adw.OverlaySplitView stacked_osv {
            sidebar-width-fraction: 0.28;
            min-sidebar-width: 250;
            max-sidebar-width: 300;
            show-sidebar: true;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Paned stacked_paned {
              styles [
                "wide-grab-divider",
              ]

              orientation: vertical;
              position: 300;
              shrink-start-child: false;
              shrink-end-child: false;
              resize-start-child: false;
              resize-end-child: true;

              start-child: Adw.LayoutSlot {
                id: "list";
              };

              end-child: Adw.LayoutSlot {
                id: "content";
              };
            };
          };

          [bottom]
          Adw.LayoutSlot {
            id: "switcher";
          }
        };
      }

      /* Dense: stacked, with the agenda pulled out of the sidebar into
       * a column of its own that keeps its width as the window grows. */
      Adw.Layout {
        name: "desktop-dense";

        content: Adw.ToolbarView {
          bottom-bar-style: raised;

          content: Adw.OverlaySplitView dense_osv {
            sidebar-width-fraction: 0.28;
            min-sidebar-width: 250;
            max-sidebar-width: 300;
            show-sidebar: true;

            sidebar: Adw.LayoutSlot {
              id: "sidebar";
            };

            content: Paned dense_agenda_paned {
              styles [
                "wide-grab-divider",
              ]

              orientation: horizontal;
              shrink-start-child: false;
              shrink-end-child: false;
              resize-start-child: true;
              resize-end-child: false;

              start-child: Paned dense_paned {
                styles [
                  "wide-grab-divider",
                ]

                orientation: vertical;
                position: 300;
                shrink-start-child: false;
                shrink-end-child: false;
                resize-start-child: false;
                resize-end-child: true;

                start-child: Adw.LayoutSlot {
                  id: "list";
                };

                end-child: Adw.LayoutSlot {
                  id: "content";
                };
              };

              end-child: Adw.LayoutSlot {
                id: "agenda";
              };
            };
          };

          [bottom]
          Adw.LayoutSlot {
            id: "switcher";
          }
        };
      }

      Adw.Layout {
        name: "tablet";

        content: Adw.OverlaySplitView tablet_osv {
          sidebar-width-fraction: 0.28;
          min-sidebar-width: 280;
          max-sidebar-width: 340;
          collapsed: true;

          sidebar: Adw.LayoutSlot {
            id: "sidebar";
          };

          content: Adw.ToolbarView {
            bottom-bar-style: raised;

            content: Paned tablet_paned {
              styles [
                "wide-grab-divider",
              ]

              orientation: horizontal;
              position: 400;
              shrink-start-child: false;
              shrink-end-child: false;
              resize-start-child: false;
              resize-end-child: true;

              start-child: Adw.LayoutSlot {
                id: "list";
              };

              end-child: Adw.LayoutSlot {
                id: "content";
              };
            };

            [bottom]
            Adw.LayoutSlot {
              id: "switcher";
            }
          };
        };
      }

      /* Both stacked and dense land here once the window is too narrow
       * for an agenda column of its own. */
      Adw.Layout {
        name: "tablet-stacked";

        content: Adw.OverlaySplitView tablet_stacked_osv {
          sidebar-width-fraction: 0.28;
          min-sidebar-width: 280;
          max-sidebar-width: 340;
          collapsed: true;

          sidebar: Adw.LayoutSlot {
            id: "sidebar";
          };

          content: Adw.ToolbarView {
            bottom-bar-style: raised;

            content: Paned tablet_stacked_paned {
              styles [
                "wide-grab-divider",
              ]

              orientation: vertical;
              position: 300;
              shrink-start-child: false;
              shrink-end-child: false;
              resize-start-child: false;
              resize-end-child: true;

              start-child: Adw.LayoutSlot {
                id: "list";
              };

              end-child: Adw.LayoutSlot {
                id: "content";
              };
            };

            [bottom]
            Adw.LayoutSlot {
              id: "switcher";
            }
          };
        };
      }

      Adw.Layout {
        name: "mobile";

        content: Adw.NavigationView mobile_nav {
          Adw.NavigationPage {
            title: _("Mail");
            tag: "main";

            child: Adw.OverlaySplitView mobile_osv {
              collapsed: true;
              sidebar-position: start;
              sidebar-width-fraction: 0.75;
              min-sidebar-width: 280;
              max-sidebar-width: 300;

              sidebar: Adw.LayoutSlot {
                id: "sidebar";
              };

              content: Adw.ToolbarView {
                styles [
                  "secondary-sidebar-pane",
                ]

                content: Adw.LayoutSlot {
                  id: "list";
                };

                [bottom]
                Adw.LayoutSlot {
                  id: "switcher";
                }
              };
            };
          }

          Adw.NavigationPage {
            title: _("Details");
            tag: "content";
            hidden => $on_details_hidden();

            child: Adw.LayoutSlot {
              id: "content";
            };
          }
        };
      }

      [switcher]
      Adw.ViewSwitcher app_switcher {
        stack: bind template.stack;
        policy: wide;
        halign: center;
        margin-top: 6;
        margin-bottom: 6;
      }
    };
  };
}
