using Gtk 4.0;
using Adw 1;

menu menu {
  section {
    item {
      label: _("Mark _Unread");
      acion: "message.mark-unread";
      hidden-when: "disabled";
    }
    item {
      label: _("Mark _Read");
      acion: "message.mark-read";
      hidden-when: "disabled";
    }
    item {
      label: _("_Junk");
      acion: "message.move-to-junk";
      hidden-when: "disabled";
    }
    item {
      label: _("_Not Junk");
      acion: "message.move-to-inbox";
      hidden-when: "disabled";
    }
  }
  section {
    item {
      label: _("View Source");
      action: "message.view-source";
      hidden-when: "disabled";
    }
  }
}

template $StampMailMessageHeader: Adw.ActionRow {
  styles [ "message-header" ]

  child: Gtk.Grid {
    margin-top: 12;
    margin-start: 12;
    margin-end: 12;
    margin-bottom: 12;
    column-spacing: 12;

    Adw.Avatar avatar {
      size: 48;

      layout {
        column: 0;
        row: 0;
        row-span: 3;
      }
    }

    Gtk.Box {
      baseline-position: top;
      spacing: 6;
      layout {
        column: 1;
        row: 0;
        column-span: 2;
      }

      Gtk.Label from_short {
        visible: bind template.collapsed;
        hexpand: true;
        xalign: 0;
        // halign: start;
        valign: baseline_fill;
      }

      Gtk.Label from_full {
        visible: bind template.collapsed inverted;
        label: _("Unknown Sender");
        use-markup: true;
        hexpand: true;
        ellipsize: end;
        xalign: 0;
        // halign: start;
        valign: baseline_fill;
      }

      Gtk.Image attachment_icon {
        valign: baseline_fill;
        visible: false;
        icon-name: "mail-attachment-symbolic";
        styles [ "dim-label" ]
      }

      Gtk.Label date {
        valign: baseline_fill;
        xalign: 1;
        styles [ "caption", "dim-label" ]
      }
    }

    Gtk.MenuButton menu_button {
      icon-name: "view-more-symbolic";
      menu-model: menu;
      halign: end;
      styles [ "flat" ]
      layout {
        column: 2;
        row: 1;
        row-span: 3;
      }
    }

    Gtk.Label to {
      ellipsize: end;
      hexpand: true;
      use-markup: true;
      halign: start;
      layout {
        column: 1;
        row: 1;
      }
    }

    Gtk.Label cc {
      wrap: true;
      wrap-mode: word_char;
      hexpand: true;
      use-markup: true;
      halign: start;
      layout {
        column: 1;
        row: 2;
      }
    }

    Gtk.Inscription body_preview {
      visible: bind template.collapsed;
      hexpand: true;
      xalign: 0;
      yalign: 0;
      min-lines: 2;
      layout {
        column: 1;
        row: 2;
      }
    }
  };
}