using Gtk 4.0;
using Adw 1;

template $StampInvitationDialog: Adw.Dialog {
  content-width: 480;
  content-height: 640;
  title: _("Invitation");

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {}

    content: ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;

      child: Adw.Clamp {
        maximum-size: 600;

        child: Box {
          orientation: vertical;
          spacing: 18;
          margin-top: 12;
          margin-bottom: 18;
          margin-start: 18;
          margin-end: 18;

          Box {
            orientation: vertical;
            spacing: 6;

            Label summary_label {
              wrap: true;
              wrap-mode: word_char;
              xalign: 0.0;
              selectable: true;

              styles [
                "title-2",
              ]
            }

            Label date_time_label {
              wrap: true;
              xalign: 0.0;

              styles [
                "dimmed",
              ]
            }

            Label location_label {
              visible: false;
              wrap: true;
              wrap-mode: word_char;
              xalign: 0.0;
              selectable: true;
            }

            Label response_label {
              visible: false;
              wrap: true;
              xalign: 0.0;
              margin-top: 6;

              styles [
                "dimmed",
              ]
            }
          }

          /* One row per meeting link, each with its own Join button. The
           * rows are GNOME Calendar's, the same ones its event popover
           * shows, so a call looks the same from the mail and from the
           * calendar. */
          ListBox meetings_listbox {
            visible: false;
            selection-mode: none;

            styles [
              "calendar-list",
            ]
          }

          Adw.PreferencesGroup participants_group {
            visible: false;
            title: _("Participants");
          }

          Box notes_box {
            visible: false;
            orientation: vertical;
            spacing: 6;

            Label {
              xalign: 0.0;
              label: _("Notes");

              styles [
                "heading",
              ]
            }

            Label description_label {
              wrap: true;
              wrap-mode: word_char;
              xalign: 0.0;
              selectable: true;
            }
          }
        };
      };
    };

    [bottom]
    Box {
      spacing: 12;
      homogeneous: true;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 18;
      margin-end: 18;

      Button decline_button {
        label: _("_Decline");
        use-underline: true;
        clicked => $on_decline_clicked();

        styles [
          "destructive-action",
        ]
      }

      Button tentative_button {
        label: _("_Tentative");
        use-underline: true;
        clicked => $on_tentative_clicked();
      }

      Button accept_button {
        label: _("_Accept");
        use-underline: true;
        clicked => $on_accept_clicked();

        styles [
          "suggested-action",
        ]
      }

      Button add_button {
        visible: false;
        label: _("Add to _Calendar");
        use-underline: true;
        clicked => $on_add_clicked();

        styles [
          "suggested-action",
        ]
      }
    }
  };
}
