using Gtk 4.0;
using Adw 1;

template $StampHeaderBar: Adw.Bin {
  child: Adw.HeaderBar {
    [start]
    $StampProfileButton {}

    [start]
    Adw.Spinner spinner {
      visible: false;
    }

    [end]
    MenuButton {
      primary: true;
      icon-name: "open-menu-symbolic";
      menu-model: primary_menu;
      tooltip-text: _("Menu");

      accessibility {
        label: _("Menu");
      }
    }
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Accounts…");
      action: 'app.accounts';
    }
  }

  section {
    label: _("Layout");

    item {
      label: _("_Side by Side");
      action: 'win.mail-layout';
      target: 'side-by-side';
    }

    item {
      label: _("S_tacked");
      action: 'win.mail-layout';
      target: 'stacked';
    }

    item {
      label: _("_Dense");
      action: 'win.mail-layout';
      target: 'dense';
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: 'app.preferences';
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Post");
      action: 'app.about';
    }
  }

  section {
    item {
      label: _("_Quit");
      action: 'app.quit';
    }
  }
}
