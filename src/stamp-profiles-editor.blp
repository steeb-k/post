using Gtk 4.0;
using Adw 1;

template $StampProfilesEditor: Adw.NavigationPage {
  title: _("Profile");
  tag: "editor";

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle editor_title {};
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.Avatar preview {
          size: 72;
          margin-bottom: 12;
        }
      }

      Adw.PreferencesGroup {
        Adw.EntryRow name_row {
          title: _("Name");
          changed => $on_name_changed();
        }

        Adw.ActionRow {
          title: _("Color");

          [suffix]
          Box swatches {
            orientation: horizontal;
            spacing: 6;
            valign: center;
          }
        }

        Adw.ActionRow badge_row {
          title: _("Badge");
          subtitle: _("Shown in place of the profile's letter.");
          activatable: true;
          activated => $on_badge_row_activated();

          [suffix]
          Adw.Avatar badge_preview {
            size: 32;
            valign: center;
          }

          [suffix]
          Image {
            icon-name: "go-next-symbolic";
            valign: center;
          }
        }

        Adw.ComboRow layout_row {
          title: _("Layout");
          subtitle: _("Applies while the profile is active. The default comes back when its turn ends.");
          notify::selected => $on_layout_changed();

          model: StringList {
            strings [
              C_("Mail layout", "Default"),
              C_("Mail layout", "Side by Side"),
              C_("Mail layout", "Stacked"),
              C_("Mail layout", "Dense"),
            ]
          };
        }

        Adw.ComboRow clustering_row {
          title: _("Clustered");
          subtitle: _("Whether mails sharing a subject are gathered into one conversation while the profile is active.");
          notify::selected => $on_clustering_changed();

          model: StringList {
            strings [
              C_("Mail clustering", "Default"),
              C_("Mail clustering", "On"),
              C_("Mail clustering", "Off"),
            ]
          };
        }

        Adw.ComboRow mail_badge_row {
          title: _("Mail Badge");
          subtitle: _("Whether the Mail button counts the unread mail in this profile's inboxes while it is active.");
          notify::selected => $on_mail_badge_changed();

          model: StringList {
            strings [
              C_("Notification badge", "Default"),
              C_("Notification badge", "On"),
              C_("Notification badge", "Off"),
            ]
          };
        }

        Adw.ComboRow calendar_badge_row {
          title: _("Calendar Badge");
          subtitle: _("Whether the Calendar button counts today's events while the profile is active.");
          notify::selected => $on_calendar_badge_changed();

          model: StringList {
            strings [
              C_("Notification badge", "Default"),
              C_("Notification badge", "On"),
              C_("Notification badge", "Off"),
            ]
          };
        }
      }

      Adw.PreferencesGroup accounts_group {
        title: _("Accounts");
        description: _("Only these accounts are shown while the profile is active. Everything else keeps syncing quietly in the background.");
      }

      Adw.PreferencesGroup rules_group {
        title: _("Schedule");
        description: _("The profile switches itself on during these hours. Picking a profile by hand overrides the schedule until it next changes.");

        [header-suffix]
        Button {
          icon-name: "list-add-symbolic";
          tooltip-text: _("Add Schedule Rule");
          clicked => $on_add_rule_clicked();

          styles [
            "flat",
          ]

          accessibility {
            label: _("Add Schedule Rule");
          }
        }
      }

      Adw.PreferencesGroup {
        Adw.ButtonRow remove_row {
          title: _("Remove Profile");
          activated => $on_remove_clicked();

          styles [
            "destructive-action",
          ]
        }
      }
    };
  };
}
