{
  "id": "io.github.steeb_k.Post",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "post-mail",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=pcsc",
    "--socket=wayland",
    "--talk-name=org.gnome.OnlineAccounts",
    "--own-name=org.gnome.OnlineAccounts",
    "--own-name=org.gnome.OnlineAccounts.*",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.gnome.keyring.SystemPrompter",
    "--filesystem=/tmp",
    "--filesystem=~/.pki/nssdb:rw",
    "--filesystem=xdg-config/pki:rw",
    "--filesystem=~/.gnupg:rw",
    "--filesystem=xdg-config/gnupg:rw",
    "--filesystem=xdg-run/p11-kit/pkcs11"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "liboauth",
      "buildsystem": "autotools",
      "config-opts": [
        "--enable-nss"
      ],
      "cleanup": [
        "/share/man"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/x42/liboauth.git",
          "tag": "v1.0.3",
          "commit": "07fc30bf6d44f5b431a943452f6083fbaf22bc8f"
        },
        {
          "type": "script",
          "dest-filename": "autogen.sh",
          "commands": [
            "set -e",
            "mkdir -p m4",
            "autoreconf -ivf"
          ]
        }
      ]
    },
    {
      "name": "librest",
      "buildsystem": "meson",
      "config-opts": [
        "-Dexamples=false",
        "-Dgtk_doc=false",
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/librest.git",
          "branch": "master"
        }
      ]
    },
    {
      "name": "gnome-online-accounts",
      "buildsystem": "meson",
      "config-opts": [
        "-Dvapi=false",
        "-Dintrospection=false",
        "-Dkerberos=false"
      ],
      "cleanup": [
        "/bin",
        "/share/dbus-1/services/org.gnome.OnlineAccounts.service"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/gnome-online-accounts.git",
          "branch": "master"
        }
      ]
    },
    {
      "name": "evolution-data-server",
      "buildsystem": "cmake-ninja",
      "cleanup": [
        "/etc",
        "/share/GConf",
        "/share/pixmaps"
      ],
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DDBUS_SERVICES_PREFIX=io.github.steeb_k.Post",
        "-DENABLE_EXAMPLES=OFF",
        "-DENABLE_GOA=ON",
        "-DENABLE_OAUTH2=ON",
        "-DWITH_LIBDB=OFF",
        "-DENABLE_WEATHER=OFF",
        "-DENABLE_CANBERRA=OFF",
        "-DENABLE_VALA_BINDINGS=OFF",
        "-DWITH_KRB5=OFF",
        "-DWITH_OPENLDAP=OFF",
        "-DENABLE_INTROSPECTION=OFF",
        "-DENABLE_INSTALLED_TESTS=OFF",
        "-DENABLE_GTK_DOC=OFF",
        "-DWITH_PRIVATE_DOCS=OFF",
        "-DWITH_SYSTEMDUSERUNITDIR=OFF",
        "-DENABLE_TESTS=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/evolution-data-server/3.60/evolution-data-server-3.60.2.tar.xz",
          "sha256": "2084dbdac396371b365d504c1ff45866ba8dca2f1252e5da1d3d9c33abdc1286"
        }
      ],
      "modules": [
        {
          "name": "intltool",
          "cleanup": [
            "*"
          ],
          "sources": [
            {
              "type": "archive",
              "url": "https://launchpad.net/intltool/trunk/0.51.0/+download/intltool-0.51.0.tar.gz",
              "sha256": "67c74d94196b153b774ab9f89b2fa6c6ba79352407037c8c14d5aeb334e959cd"
            }
          ]
        },
        {
          "name": "libical",
          "cleanup": [
            "/lib/cmake",
            "/libexec"
          ],
          "buildsystem": "cmake-ninja",
          "config-opts": [
            "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
            "-DCMAKE_INSTALL_LIBDIR=/app/lib",
            "-DWITH_CXX_BINDINGS=false",
            "-DSHARED_ONLY=true",
            "-DGOBJECT_INTROSPECTION=true",
            "-DICAL_BUILD_DOCS=false",
            "-DICAL_GLIB_VAPI=true",
            "-DLIBICAL_BUILD_TESTING=false"
          ],
          "sources": [
            {
              "type": "git",
              "url": "https://github.com/libical/libical.git",
              "tag": "v3.0.20"
            }
          ]
        }
      ]
    },
    {
      "name": "libportal",
      "buildsystem": "meson",
      "config-opts": [
        "-Dbackend-gtk4=enabled",
        "-Dintrospection=false",
        "-Ddocs=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/flatpak/libportal.git",
          "branch": "main"
        }
      ]
    },
    {
      "name": "evolution-ews",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DWITH_MSPACK=OFF",
        "-DWITH_EVOLUTION=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/evolution-ews/3.60/evolution-ews-3.60.2.tar.xz",
          "sha256": "940205818f6988411457ddf5804d210f3515c26e33415debd8fbb2731b1daf2b"
        }
      ],
      "post-install": [
        "cp NEWS /app/share/NEWS.ews"
      ]
    },
    {
      "name": "geocode-glib",
      "buildsystem": "meson",
      "config-opts": [
        "-Dsoup2=false",
        "-Denable-gtk-doc=false",
        "-Denable-introspection=false",
        "-Denable-installed-tests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/geocode-glib/3.26/geocode-glib-3.26.4.tar.xz",
          "sha256": "2d9a6826d158470449a173871221596da0f83ebdcff98b90c7049089056a37aa"
        }
      ]
    },
    {
      "name": "gweather-locations",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/gweather-locations/2026/gweather-locations-2026.2.tar.xz",
          "sha256": "e7570a3661e0a752a06387b2032585cf588fc56770b1f9f39f1a55d17b2835fe"
        }
      ]
    },
    {
      "name": "libgweather",
      "buildsystem": "meson",
      "config-opts": [
        "-Denable_vala=false",
        "-Dgtk_doc=false",
        "-Dintrospection=false",
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libgweather/4.6/libgweather-4.6.0.tar.xz",
          "sha256": "7f5d0e8c9685ef2ff46c2f3a57cae48d7bf3540b2d83921f889ef28e6a876788"
        }
      ]
    },
    {
      "name": "post-mail",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts": [
        "-Ddevel=false"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".",
          "skip": [
            ".flatpak-builder",
            "builddir"
          ]
        }
      ]
    },
    {
      "name": "post-mail-wrapper",
      "buildsystem": "simple",
      "build-commands": [
        "sed -e \"s|@SOURCES_SERVICE@|$(pkg-config --variable=sourcesdbusservicename evolution-data-server-1.2)|\" -e \"s|@ADDRESSBOOK_SERVICE@|$(pkg-config --variable=addressbookdbusservicename evolution-data-server-1.2)|\" -e \"s|@CALENDAR_SERVICE@|$(pkg-config --variable=calendardbusservicename evolution-data-server-1.2)|\" post-mail-wrapper.sh.in > post-mail-wrapper.sh",
        "chmod a+x post-mail-wrapper.sh",
        "mv /app/bin/post-mail /app/bin/post-mail.bin",
        "cp post-mail-wrapper.sh /app/bin/post-mail"
      ],
      "sources": [
        {
          "type": "script",
          "dest-filename": "post-mail-wrapper.sh.in",
          "commands": [
            "# The session bus cannot activate service files that live inside the",
            "# sandbox, so start the data server ourselves. The names are prefixed",
            "# with the app id (DBUS_SERVICES_PREFIX), so this never collides with",
            "# an evolution-data-server running on the host.",
            "start_service () {",
            "  name=\"$1\"",
            "  shift",
            "  if ! gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \\",
            "       --method org.freedesktop.DBus.NameHasOwner \"${name}\" | grep -q true; then",
            "    \"$@\" &",
            "    gdbus wait --session --timeout=10 \"${name}\"",
            "  fi",
            "}",
            "",
            "# Accounts live in GNOME Online Accounts. Use the host daemon when",
            "# there is one so accounts stay shared; otherwise run our own. The",
            "# bundled service file is deleted, so the host can never activate",
            "# this behind our back \u2014 it only runs while Post does.",
            "start_service org.gnome.OnlineAccounts /app/libexec/goa-daemon",
            "start_service @SOURCES_SERVICE@ /app/libexec/evolution-source-registry",
            "start_service @ADDRESSBOOK_SERVICE@ /app/libexec/evolution-addressbook-factory -r",
            "start_service @CALENDAR_SERVICE@ /app/libexec/evolution-calendar-factory -r",
            "",
            "exec /app/bin/post-mail.bin \"$@\""
          ]
        }
      ]
    }
  ]
}
