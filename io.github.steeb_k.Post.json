{
  "id": "io.github.steeb_k.Post",
  "runtime": "org.gnome.Platform",
  "runtime-version": "master",
  "sdk": "org.gnome.Sdk",
  "command": "post-mail",
  "desktop-file-name-suffix": " (Development)",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=pcsc",
    "--socket=wayland",
    "--talk-name=org.gnome.OnlineAccounts",
    "--talk-name=org.gnome.keyring.SystemPrompter",
    "--talk-name=org.gnome.evolution.dataserver.AddressBook10",
    "--talk-name=org.gnome.evolution.dataserver.Calendar8",
    "--talk-name=org.gnome.evolution.dataserver.Sources5",
    "--talk-name=org.gnome.evolution.dataserver.Subprocess.Backend",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=/tmp",
    "--filesystem=~/.pki/nssdb:rw",
    "--filesystem=~/.cache/evolution:rw",
    "--filesystem=~/.config/evolution:rw",
    "--filesystem=xdg-config/pki:rw",
    "--filesystem=~/.gnupg:rw",
    "--filesystem=xdg-config/gnupg:rw",
    "--filesystem=xdg-run/p11-kit/pkcs11"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "liboauth",
      "buildsystem": "autotools",
      "config-opts": [
        "--enable-nss"
      ],
      "cleanup": [
        "/share/man"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/x42/liboauth.git",
          "tag": "v1.0.3",
          "commit": "07fc30bf6d44f5b431a943452f6083fbaf22bc8f"
        },
        {
          "type": "script",
          "dest-filename": "autogen.sh",
          "commands": [
            "set -e",
            "mkdir -p m4",
            "autoreconf -ivf"
          ]
        }
      ]
    },
    {
      "name": "librest",
      "buildsystem": "meson",
      "config-opts": [
        "-Dexamples=false",
        "-Dgtk_doc=false",
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/librest.git",
          "branch": "master"
        }
      ]
    },
    {
      "name": "gnome-online-accounts",
      "buildsystem": "meson",
      "config-opts": [
        "-Dvapi=false",
        "-Dgoabackend=false",
        "-Dintrospection=false",
        "-Dkerberos=false"
      ],
      "cleanup": [
        "/bin"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/gnome-online-accounts.git",
          "branch": "master"
        }
      ]
    },
    {
      "name": "evolution-data-server",
      "buildsystem": "cmake-ninja",
      "cleanup": [
        "/etc",
        "/libexec",
        "/share/dbus-1",
        "/share/GConf",
        "/share/pixmaps"
      ],
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DENABLE_EXAMPLES=OFF",
        "-DENABLE_GOA=ON",
        "-DENABLE_OAUTH2=ON",
        "-DWITH_LIBDB=OFF",
        "-DENABLE_WEATHER=OFF",
        "-DENABLE_CANBERRA=OFF",
        "-DENABLE_VALA_BINDINGS=OFF",
        "-DWITH_KRB5=OFF",
        "-DWITH_OPENLDAP=OFF",
        "-DENABLE_INTROSPECTION=OFF",
        "-DENABLE_INSTALLED_TESTS=OFF",
        "-DENABLE_GTK_DOC=OFF",
        "-DWITH_PRIVATE_DOCS=OFF",
        "-DWITH_SYSTEMDUSERUNITDIR=OFF",
        "-DENABLE_TESTS=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/evolution-data-server/3.59/evolution-data-server-3.59.2.tar.xz",
          "sha256": "15bd798c85dee923462bebe880761b4668b6c5065584e840900988389add83bf"
        }
      ],
      "modules": [
        {
          "name": "intltool",
          "cleanup": [
            "*"
          ],
          "sources": [
            {
              "type": "archive",
              "url": "https://launchpad.net/intltool/trunk/0.51.0/+download/intltool-0.51.0.tar.gz",
              "sha256": "67c74d94196b153b774ab9f89b2fa6c6ba79352407037c8c14d5aeb334e959cd"
            }
          ]
        },
        {
          "name": "libical",
          "cleanup": [
            "/lib/cmake",
            "/libexec"
          ],
          "buildsystem": "cmake-ninja",
          "config-opts": [
            "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
            "-DCMAKE_INSTALL_LIBDIR=/app/lib",
            "-DWITH_CXX_BINDINGS=false",
            "-DSHARED_ONLY=true",
            "-DGOBJECT_INTROSPECTION=true",
            "-DICAL_BUILD_DOCS=false",
            "-DICAL_GLIB_VAPI=true",
            "-DLIBICAL_BUILD_TESTING=false"
          ],
          "sources": [
            {
              "type": "git",
              "url": "https://github.com/libical/libical.git",
              "tag": "v3.0.20"
            }
          ]
        }
      ]
    },
    {
      "name" : "libportal",
      "buildsystem" : "meson",
      "config-opts" : [
        "-Dbackend-gtk4=enabled",
        "-Dintrospection=false",
        "-Ddocs=false"
      ],
      "sources" : [
        {
          "type" : "git",
          "url" : "https://github.com/flatpak/libportal.git",
          "branch" : "main"
        }
      ]
    },
    {
      "name": "evolution-ews",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DWITH_MSPACK=OFF",
        "-DENABLE_WITH_EVOLUTION=OFF"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/evolution-ews/3.59/evolution-ews-3.59.2.tar.xz",
          "sha256": "e7f5857a1b12a793aa5028c829cd93d66a7ba7fd212564b8507071cdbec515d2"
        },
        {
          "type": "patch",
          "path": "./evolution-compilation-switch.patch"
        }
      ],
      "post-install": [
        "cp NEWS /app/share/NEWS.ews"
      ]
    },
    {
      "name": "geocode-glib",
      "buildsystem": "meson",
      "config-opts": [
        "-Dsoup2=false",
        "-Denable-gtk-doc=false",
        "-Denable-introspection=false",
        "-Denable-installed-tests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/geocode-glib/3.26/geocode-glib-3.26.4.tar.xz",
          "sha256": "2d9a6826d158470449a173871221596da0f83ebdcff98b90c7049089056a37aa"
        }
      ]
    },
    {
      "name": "gweather-locations",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/gweather-locations/2026/gweather-locations-2026.2.tar.xz",
          "sha256": "e7570a3661e0a752a06387b2032585cf588fc56770b1f9f39f1a55d17b2835fe"
        }
      ]
    },
    {
      "name": "libgweather",
      "buildsystem": "meson",
      "config-opts": [
        "-Denable_vala=false",
        "-Dgtk_doc=false",
        "-Dintrospection=false",
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://download.gnome.org/sources/libgweather/4.6/libgweather-4.6.0.tar.xz",
          "sha256": "7f5d0e8c9685ef2ff46c2f3a57cae48d7bf3540b2d83921f889ef28e6a876788"
        }
      ]
    },
    {
      "name": "post-mail",
      "builddir": true,
      "buildsystem": "meson",
      "config-opts" : [
        "-Ddevel=true"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}